{
  "manifest_version": 3,
  "name": "Box Screen Lyrics Sync",
  "version": "1.0",
  "description": "Send YouTube video timecode to Box Screen for lyrics sync",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:7420/*"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
